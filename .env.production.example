# VMS Production Environment — placeholders only. Never commit real credentials.

# Application
APP_ENV=production
APP_RELEASE_VERSION=1.0.0-rc1
APP_SHUTDOWN_TIMEOUT_SECONDS=30
PUBLIC_APP_BASE_URL=https://vms.example.com
CORS_ALLOWED_ORIGINS=https://vms.example.com

# Database (PostgreSQL required in production)
DATABASE_URL=postgresql+psycopg://vms_app:CHANGE_ME@db.example.com:5432/vms
PRODUCTION_DATABASE_DIALECT=postgresql
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_SSLMODE=require
DB_STATEMENT_TIMEOUT_MS=30000
DB_APPLICATION_NAME=vms
DB_SQL_ECHO=false
SCHEMA_CHECK_ON_STARTUP=true

# Authentication — VMS Native (required in production)
AUTH_MODE=vms_native
DEV_AUTH_ENABLED=false
VMS_NATIVE_AUTH_ENABLED=true
# GLOBAL_ADMIN_INITIAL_PASSWORD=  # owner bootstrap only — set via secret manager, never commit

# Optional Microsoft Entra ID (secondary provider; OIDC only — NO Microsoft Graph)
# ENTRA_AUTH_ENABLED=false
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=https://vms.example.com/auth/callback
# ENTRA_POST_LOGOUT_REDIRECT_URI=https://vms.example.com/login

# Email (configure a production provider; dev_outbox is blocked in production)
EMAIL_PROVIDER=smtp

# Security / Encryption
AUDIT_INTEGRITY_KEY=CHANGE_ME_32_CHAR_MINIMUM_SECRET
DOCUMENT_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_MINIMUM_SECRET
VMS_DATA_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_MINIMUM_SECRET

# CORS / Frontend (VITE_* only in frontend build env)
VITE_AUTH_MODE=vms_native
VITE_ENABLE_SOURCEMAPS=false

# AI
AI_ENABLED=false
AI_PROVIDER=disabled

# File Scanning
FILE_SCANNER_PROVIDER=clamav
CLAMAV_HOST=clamav.example.com
CLAMAV_PORT=3310

# Rate Limiting
RATE_LIMIT_BACKEND=database

# Access Control
ACCESS_CONTROL_ENABLED=false
ACCESS_CONTROL_PROVIDER=disabled

# Badge Printing
BADGE_PRINTER_ENABLED=false
BADGE_PRINTER_PROVIDER=disabled

# Schedulers
BACKGROUND_SCHEDULER_ENABLED=true
RETENTION_AUTOMATION_ENABLED=true
PHYSICAL_INTEGRATION_SCHEDULER_ENABLED=true

# Live integration testing (never enable in production runtime)
ENABLE_LIVE_INTEGRATION_TESTS=false

LOG_LEVEL=INFO

# Readiness backlog thresholds
NOTIFICATION_BACKLOG_ATTENTION=100
NOTIFICATION_BACKLOG_CRITICAL=500
PHYSICAL_QUEUE_ATTENTION=50
PHYSICAL_QUEUE_CRITICAL=200
