# VMS Staging / UAT Environment — placeholders only. Never commit real credentials.
# Copy to secure staging secret store / deployment platform. See docs/release/staging-provisioning-request.md

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
APP_RELEASE_VERSION=1.0.0-rc1
PUBLIC_APP_BASE_URL=https://vms-uat.example.com
CORS_ALLOWED_ORIGINS=https://vms-uat.example.com

# ── PostgreSQL (application) ─────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://vms_app:CHANGE_ME@db-staging.example.com:5432/vms_staging
PRODUCTION_DATABASE_DIALECT=postgresql
DB_SSLMODE=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_APPLICATION_NAME=vms-staging
DB_SQL_ECHO=false
SCHEMA_CHECK_ON_STARTUP=true

# ── PostgreSQL live validation (separate disposable DBs — NOT application DB) ─
# Set only on engineering test runners / CI, not necessarily on app runtime:
TEST_POSTGRES_URL=postgresql+psycopg://vms_test:CHANGE_ME@db-staging.example.com:5432/vms_staging_integration_test
TEST_POSTGRES_RESTORE_URL=postgresql+psycopg://vms_test:CHANGE_ME@db-staging.example.com:5432/vms_staging_restore_test
ALLOW_POSTGRES_TEST_DATABASE=true
ENABLE_LIVE_INTEGRATION_TESTS=true

# ── Authentication (Entra) ───────────────────────────────────────────────────
AUTH_MODE=entra
DEV_AUTH_ENABLED=false
ENTRA_TENANT_ID=CHANGE_ME
ENTRA_API_AUDIENCE=api://CHANGE_ME
ENTRA_REQUIRED_SCOPE=VMS.Access
ENTRA_ALLOWED_CLIENT_IDS=
ENTRA_CLOCK_SKEW_SECONDS=120

# ── Email (Graph) ────────────────────────────────────────────────────────────
EMAIL_PROVIDER=ms_graph
GRAPH_TENANT_ID=CHANGE_ME
GRAPH_CLIENT_ID=CHANGE_ME
GRAPH_CLIENT_SECRET=CHANGE_ME
GRAPH_SENDER_MAILBOX=vms-uat-notifications@example.com
GRAPH_TIMEOUT_SECONDS=15
GRAPH_SAVE_TO_SENT_ITEMS=true
EMAIL_LIVE_TEST_RECIPIENT=uat-mailbox@example.com
LIVE_EMAIL_ALLOWED_RECIPIENTS=uat-mailbox@example.com,uat-mailbox2@example.com

# ── Security keys (production strength — secret manager) ─────────────────────
AUDIT_INTEGRITY_KEY=CHANGE_ME_MIN_32_CHARS_HIGH_ENTROPY
DOCUMENT_ENCRYPTION_KEY=CHANGE_ME_MIN_32_CHARS_HIGH_ENTROPY
VMS_DATA_ENCRYPTION_KEY=CHANGE_ME_MIN_32_CHARS_HIGH_ENTROPY

# ── File scanning (required when APP_ENV=production) ─────────────────────────
FILE_SCANNER_PROVIDER=clamav
CLAMAV_HOST=clamav-staging.internal.example.com
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=15

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_BACKEND=database

# ── Disabled for initial RC ──────────────────────────────────────────────────
AI_ENABLED=false
AI_PROVIDER=disabled
ACCESS_CONTROL_ENABLED=false
ACCESS_CONTROL_PROVIDER=disabled
BADGE_PRINTER_ENABLED=false
BADGE_PRINTER_PROVIDER=disabled

# ── Schedulers ───────────────────────────────────────────────────────────────
BACKGROUND_SCHEDULER_ENABLED=true
RETENTION_AUTOMATION_ENABLED=true
PHYSICAL_INTEGRATION_SCHEDULER_ENABLED=true

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
log_format=json

# ── Frontend build-time (Vite — set in frontend staging build pipeline) ───────
VITE_AUTH_MODE=entra
VITE_ENTRA_TENANT_ID=CHANGE_ME
VITE_ENTRA_CLIENT_ID=CHANGE_ME
VITE_ENTRA_API_SCOPE=api://CHANGE_ME/.default
VITE_ENTRA_REDIRECT_URI=https://vms-uat.example.com/auth/callback
VITE_ENTRA_POST_LOGOUT_URI=https://vms-uat.example.com/login
VITE_API_BASE_URL=https://vms-uat.example.com
VITE_ENABLE_SOURCEMAPS=false

# Runtime app should keep live integration flags false unless running test jobs:
# ENABLE_LIVE_INTEGRATION_TESTS=false
