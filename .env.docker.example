# Docker Compose / container smoke-test template — placeholders only. Never commit real secrets.
# Copy to .env.docker.local for local compose validation (gitignored).

APP_ENV=production
APP_RELEASE_VERSION=1.0.0-rc1

# PostgreSQL (compose service)
POSTGRES_PASSWORD=change-me-use-a-strong-password

# Backend
DATABASE_URL=postgresql+psycopg://vms:change-me-use-a-strong-password@postgres:5432/vms
AUTH_MODE=vms_native
DEV_AUTH_ENABLED=false
VMS_NATIVE_AUTH_ENABLED=true
EMAIL_PROVIDER=smtp
PUBLIC_APP_BASE_URL=https://localhost:7272
CORS_ALLOWED_ORIGINS=https://localhost:7272
SCHEMA_CHECK_ON_STARTUP=true
RATE_LIMIT_BACKEND=database
FILE_SCANNER_PROVIDER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
AI_ENABLED=false
AI_PROVIDER=disabled
ACCESS_CONTROL_ENABLED=false
BADGE_PRINTER_ENABLED=false
BACKGROUND_SCHEDULER_ENABLED=true
RETENTION_AUTOMATION_ENABLED=false
LOG_LEVEL=INFO

# Security keys — replace with cryptographically random values (32+ chars) before real deployment
AUDIT_INTEGRITY_KEY=replace-with-random-audit-integrity-key-32chars-min
DOCUMENT_ENCRYPTION_KEY=replace-with-random-document-encryption-key-32
VMS_DATA_ENCRYPTION_KEY=replace-with-random-vms-data-encryption-key-32b

# Owner bootstrap — set only for first-time provisioning; never commit a real value
# GLOBAL_ADMIN_INITIAL_PASSWORD=

# Frontend build (Vite)
VITE_AUTH_MODE=vms_native
VITE_ENABLE_SOURCEMAPS=false
