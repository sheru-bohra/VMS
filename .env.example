APP_NAME=Visitor Management System
APP_ENV=development

FRONTEND_PORT=7272
BACKEND_PORT=7273

DATABASE_URL=sqlite:///./data/vms-local.db

# Development authentication (APP_ENV=development, AUTH_MODE=dev)
AUTH_MODE=dev
DEV_AUTH_ENABLED=true
DEV_AUTH_EMAIL=sheru.bohra@lazypay.in
# Optional: impersonate another dev user (development only)
# DEV_AUTH_USER=security.blr@vms.local

# Production authentication (AUTH_MODE=vms_native — required in production)
# AUTH_MODE=vms_native
# VITE_AUTH_MODE=vms_native

# Optional Microsoft Entra ID (ENTRA_AUTH_ENABLED=true to show Microsoft login button)
# ENTRA_AUTH_ENABLED=false

# Microsoft Entra ID — optional legacy provider (AUTH_MODE=entra)
# OIDC scopes: openid, profile, email — NO Microsoft Graph permissions
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=http://localhost:7272/auth/callback
# ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:7272/login
# ENTRA_CLOCK_SKEW_SECONDS=120
# ENTRA_ALLOWED_CLIENT_IDS=

# Initial Global Admin bootstrap (only when no Global Admin exists in database)
# VMS_BOOTSTRAP_ADMIN_EMAIL=

# VMS native authentication
# GLOBAL_ADMIN_INITIAL_PASSWORD=  # owner bootstrap secret only — never commit
# Used only for initial owner provisioning or recovery before the owner changes their password.
# After the owner changes their password, the database hash is authoritative and startup never overwrites it.

# Email (development uses dev outbox; Microsoft Graph is NOT used)
EMAIL_PROVIDER=dev_outbox

# Secure notification delivery (host approval URLs at rest)
# VMS_DATA_ENCRYPTION_KEY=

PUBLIC_APP_BASE_URL=http://localhost:7272
CORS_ORIGINS=http://localhost:7272

# Frontend (Vite)
# VITE_AUTH_MODE=entra
# VITE_ENTRA_TENANT_ID=
# VITE_ENTRA_CLIENT_ID=
# VITE_ENTRA_REDIRECT_URI=http://localhost:7272/auth/callback
# VITE_ENTRA_POST_LOGOUT_URI=http://localhost:7272/login

# Phase 13 security (development defaults)
# AUDIT_INTEGRITY_KEY=development-only-change-for-local-use-32chars
# DOCUMENT_ENCRYPTION_KEY=development-only-document-encryption-key-32
# RATE_LIMIT_BACKEND=memory
# FILE_SCANNER_PROVIDER=dev_noop
# RETENTION_AUTOMATION_ENABLED=false

# Phase 14 physical integrations (development defaults)
# ACCESS_CONTROL_ENABLED=false
# ACCESS_CONTROL_PROVIDER=disabled
# ACCESS_CONTROL_REQUIRED_FOR_READINESS=false
# ACCESS_PROVIDER_TIMEOUT_SECONDS=15
# ACCESS_PROVIDER_MAX_ATTEMPTS=5
# ACCESS_PROVIDER_RETRY_BASE_SECONDS=30
# BADGE_PRINTER_ENABLED=false
# BADGE_PRINTER_PROVIDER=disabled
# BADGE_PRINTER_REQUIRED_FOR_READINESS=false
# BADGE_PRINTER_TIMEOUT_SECONDS=15
# BADGE_PRINT_MAX_ATTEMPTS=3
# PHYSICAL_INTEGRATION_SCHEDULER_ENABLED=true
